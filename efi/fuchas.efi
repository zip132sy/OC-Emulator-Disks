-- Fuchas EFI
-- Locates a Fuchas installation on any attached filesystem and starts its kernel.
local function findFuchas()
  for addr in component.list("filesystem") do
    local handle = component.invoke(addr, "open", "/Fuchas/Kernel/boot.lua")
    if handle then
      component.invoke(addr, "close", handle)
      return addr
    end
  end
end

local addr = findFuchas()
if not addr then
  local gpu = component.list("gpu")()
  local screen = component.list("screen")()
  if gpu and screen then
    component.invoke(gpu, "bind", screen)
    component.invoke(gpu, "set", 1, 1, "No Fuchas installation found")
    component.invoke(gpu, "set", 1, 2, "Attach a disk with /Fuchas and reboot")
  end
  while true do computer.pullSignal(1) end
end

if computer.getBootAddress() ~= addr then
  computer.setBootAddress(addr)
end

local handle, reason = component.invoke(addr, "open", "/Fuchas/Kernel/boot.lua")
assert(handle, reason)
local buffer = ""
repeat
  local data, err = component.invoke(addr, "read", handle, math.huge)
  assert(data or not err, err)
  buffer = buffer .. (data or "")
until not data
component.invoke(addr, "close", handle)

local kernel, err = load(buffer, "=Fuchas/Kernel/boot.lua", "bt", _G)
assert(kernel, err)
kernel()
